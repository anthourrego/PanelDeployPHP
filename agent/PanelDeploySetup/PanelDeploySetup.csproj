<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(AgentExecutable)" LogicalName="PanelDeployAgent.exe" />
  </ItemGroup>
  <Target Name="RequireAgentExecutable" BeforeTargets="PrepareForBuild" Condition="!Exists('$(AgentExecutable)')">
    <Error Text="Publique el agente primero y pase su ruta absoluta con -p:AgentExecutable." />
  </Target>
</Project>
